      "pronation":  { "key": "elbow_pronation",  "label": "Pronation",  "normal": 80,  "unit": "°", "limited_suggests": ["Radial head pathology", "DRUJ dysfunction"] },
      "supination": { "key": "elbow_supination", "label": "Supination", "normal": 80,  "unit": "°", "limited_suggests": ["Radial head pathology", "Biceps tendon pathology"] }
    },
    "wrist": {
