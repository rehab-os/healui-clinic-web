      "extension":  { "key": "shoulder_extension", "label": "Extension",     "normal": 60,  "unit": "°", "limited_suggests": ["Anterior capsule tightness"] },
      "abduction":  { "key": "shoulder_abduction", "label": "Abduction",     "normal": 180, "unit": "°", "limited_suggests": ["Adhesive capsulitis", "Impingement", "AC joint pathology"], "full_painful_suggests": ["Subacromial bursitis"] },
      "adduction":  { "key": "shoulder_adduction", "label": "Adduction",     "normal": 45,  "unit": "°", "limited_suggests": ["AC joint pathology"] },
