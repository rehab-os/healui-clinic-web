      "extension":  { "key": "wrist_extension",  "label": "Extension",        "normal": 70, "unit": "°", "limited_suggests": ["Wrist OA", "Volar capsule tightness", "Carpal tunnel"] },
      "radial_dev": { "key": "wrist_radial_dev", "label": "Radial Deviation", "normal": 20, "unit": "°", "limited_suggests": ["De Quervain's tenosynovitis", "Scaphoid pathology"] },
      "ulnar_dev":  { "key": "wrist_ulnar_dev",  "label": "Ulnar Deviation",  "normal": 30, "unit": "°", "limited_suggests": ["TFCC injury", "Ulnar styloid pathology"] }
    },
    "hip": {
      "flexion":   { "key": "hip_flexion",   "label": "Flexion",       "normal": 120, "unit": "°", "limited_suggests": ["Hip OA", "FAI", "Iliopsoas tightness", "Capsular tightness"] },
      "extension": { "key": "hip_extension", "label": "Extension",     "normal": 30,  "unit": "°", "limited_suggests": ["Hip flexor tightness", "Hip OA", "FAI anterior"] },
      "abduction": { "key": "hip_abduction", "label": "Abduction",     "normal": 45,  "unit": "°", "limited_suggests": ["Hip OA", "Adductor tightness"] },
      "adduction": { "key": "hip_adduction", "label": "Adduction",     "normal": 30,  "unit": "°", "limited_suggests": ["IT band tightness", "Hip abductor pathology"] },
      "ir":        { "key": "hip_ir",        "label": "Int. Rotation", "normal": 35,  "unit": "°", "limited_suggests": ["FAI (cam morphology)", "Labral tear", "Hip OA (early sign)"] },
      "er":        { "key": "hip_er",        "label": "Ext. Rotation", "normal": 45,  "unit": "°", "limited_suggests": ["Piriformis tightness", "Post-capsular tightness"] }
    },
    "knee": {
      "flexion":   { "key": "knee_flexion",   "label": "Flexion",   "normal": 135, "unit": "°", "limited_suggests": ["Effusion", "OA", "Post-surgical stiffness", "Hamstring tightness"] },
      "extension": { "key": "knee_extension", "label": "Extension", "normal": 0,   "unit": "°", "limited_suggests": ["ACL tear (extension block)", "Meniscal block", "Effusion", "Quad weakness"] }
    },
    "ankle": {
      "dorsiflexion":   { "key": "ankle_dorsiflexion",   "label": "Dorsiflexion",   "normal": 20, "unit": "°", "limited_suggests": ["Achilles tightness", "Ankle OA", "Plantar fasciitis"] },
      "plantarflexion": { "key": "ankle_plantarflexion", "label": "Plantarflexion", "normal": 50, "unit": "°", "limited_suggests": ["Anterior ankle impingement", "Dorsal capsule tightness"] },
      "inversion":      { "key": "ankle_inversion",      "label": "Inversion",      "normal": 35, "unit": "°", "limited_suggests": ["Lateral ligament sprain", "Peroneal tendon pathology"] },
      "eversion":       { "key": "ankle_eversion",       "label": "Eversion",       "normal": 20, "unit": "°", "limited_suggests": ["Medial ligament sprain", "Posterior tibial tendon pathology"] }
    },
    "foot": {
      "dorsiflexion":   { "key": "ankle_dorsiflexion",   "label": "Dorsiflexion",   "normal": 20, "unit": "°" },
      "plantarflexion": { "key": "ankle_plantarflexion", "label": "Plantarflexion", "normal": 50, "unit": "°" }
