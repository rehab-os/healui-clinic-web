    "thoracic": {
      "flexion":    { "key": "thoracic_flexion",    "label": "Flexion",      "normal": 40, "unit": "°", "limited_suggests": ["Hyperkyphosis", "Thoracic OA", "Rib dysfunction"] },
      "extension":  { "key": "thoracic_extension",  "label": "Extension",    "normal": 20, "unit": "°", "limited_suggests": ["Hyperkyphosis", "Facet joint stiffness"] },
      "rotation_l": { "key": "thoracic_rotation_l", "label": "Rotation (L)", "normal": 35, "unit": "°", "limited_suggests": ["Rib restriction", "Thoracic facet joint stiffness"] },
      "rotation_r": { "key": "thoracic_rotation_r", "label": "Rotation (R)", "normal": 35, "unit": "°", "limited_suggests": ["Rib restriction", "Thoracic facet joint stiffness"] }
    }
