{
  "version": "1.0",
  "description": "ROM measurement types, pain responses, and per-movement clinical data. Used to drive the custom ROM input in ExaminationMode.",

  "measurement_types": [
    { "key": "active",   "label": "Active",   "abbr": "AROM",  "description": "Patient moves independently" },
    { "key": "passive",  "label": "Passive",  "abbr": "PROM",  "description": "Examiner moves the joint" },
    { "key": "assisted", "label": "Assisted", "abbr": "AAROM", "description": "Gravity eliminated or assisted" }
  ],

  "pain_during_movement": [
    { "key": "none",        "label": "No pain",    "color": "green"  },
    { "key": "end_range",   "label": "End range",  "color": "amber"  },
    { "key": "throughout",  "label": "Throughout", "color": "orange" },
    { "key": "painful_arc", "label": "Painful arc","color": "red"    },
    { "key": "increases",   "label": "Increases",  "color": "red"    }
  ],

  "movements": {
    "lumbar": {
      "flexion":    { "key": "lumbar_flexion",    "label": "Flexion",       "normal": 60, "unit": "°", "limited_suggests": ["Disc herniation", "Facet joint irritation", "Muscle spasm"], "full_painful_suggests": ["Discogenic pain", "Ligamentous strain"] },
      "extension":  { "key": "lumbar_extension",  "label": "Extension",     "normal": 25, "unit": "°", "limited_suggests": ["Facet joint arthropathy", "Spinal stenosis", "Spondylolisthesis"], "full_painful_suggests": ["Facet impingement", "Spondylolysis"] },
      "lat_flex_l": { "key": "lumbar_lat_flex_l", "label": "Lat. Flex (L)", "normal": 25, "unit": "°", "limited_suggests": ["Ipsilateral facet restriction", "Disc herniation L-side"] },
      "lat_flex_r": { "key": "lumbar_lat_flex_r", "label": "Lat. Flex (R)", "normal": 25, "unit": "°", "limited_suggests": ["Ipsilateral facet restriction", "Disc herniation R-side"] },
      "rotation_l": { "key": "lumbar_rotation_l", "label": "Rotation (L)",  "normal": 30, "unit": "°", "limited_suggests": ["Facet joint restriction"] },
      "rotation_r": { "key": "lumbar_rotation_r", "label": "Rotation (R)",  "normal": 30, "unit": "°", "limited_suggests": ["Facet joint restriction"] }
    },
    "cervical": {
      "flexion":    { "key": "cervical_flexion",    "label": "Flexion",       "normal": 50, "unit": "°", "limited_suggests": ["Upper cervical hypomobility", "Disc herniation", "Muscle guarding"] },
      "extension":  { "key": "cervical_extension",  "label": "Extension",     "normal": 60, "unit": "°", "limited_suggests": ["Facet joint stiffness", "Cervical stenosis", "Posterior disc bulge"] },
      "rotation_l": { "key": "cervical_rotation_l", "label": "Rotation (L)",  "normal": 80, "unit": "°", "limited_suggests": ["C1/C2 dysfunction", "Ipsilateral capsular tightness"] },
      "rotation_r": { "key": "cervical_rotation_r", "label": "Rotation (R)",  "normal": 80, "unit": "°", "limited_suggests": ["C1/C2 dysfunction", "Ipsilateral capsular tightness"] },
      "lat_flex_l": { "key": "cervical_lat_flex_l", "label": "Lat. Flex (L)", "normal": 45, "unit": "°", "limited_suggests": ["Scalene tightness", "C-spine disc herniation"] },
      "lat_flex_r": { "key": "cervical_lat_flex_r", "label": "Lat. Flex (R)", "normal": 45, "unit": "°", "limited_suggests": ["Scalene tightness", "C-spine disc herniation"] }
    },
    "shoulder": {
