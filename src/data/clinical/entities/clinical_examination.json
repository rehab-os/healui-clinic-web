{
  "version": "1.0",
  "description": "Physical examination data for all clinical specialties. MSK now. Neurological and cardiorespiratory planned. All examination data lives here — not in assessments files.",

  "universal_scales": {
    "tenderness_grading": {
      "type": "ordinal_0_to_3",
      "label": "Tenderness Grade",
      "clinical_note": "Standard clinical tenderness grading — grade the response, not just presence",
      "grades": [
        { "value": 0, "label": "None",     "chip": "0", "description": "No tenderness on palpation" },
        { "value": 1, "label": "Mild",     "chip": "1+", "description": "Tender — patient acknowledges, no grimace" },
        { "value": 2, "label": "Moderate", "chip": "2+", "description": "Grimace or verbal response on palpation" },
        { "value": 3, "label": "Severe",   "chip": "3+", "description": "Withdraws, guards, or refuses touch" }
      ]
    },
    "swelling_grading": {
      "type": "ordinal_0_to_4",
      "label": "Swelling Grade",
      "grades": [
        { "value": 0, "label": "None"     },
        { "value": 1, "label": "Trace"    },
        { "value": 2, "label": "Mild"     },
        { "value": 3, "label": "Moderate" },
        { "value": 4, "label": "Marked"   }
      ],
      "type_options": ["Boggy (fluid)", "Firm (fibrotic)", "Mixed"]
    },
    "muscle_guarding_grading": {
      "type": "ordinal_0_to_3",
      "grades": [
        { "value": 0, "label": "None"     },
        { "value": 1, "label": "Mild"     },
        { "value": 2, "label": "Moderate" },
        { "value": 3, "label": "Severe"   }
      ]
    },
    "end_feel_options": [
      { "value": "capsular",      "label": "Capsular",           "note": "Firm, leathery — capsular tightness" },
      { "value": "soft_tissue",   "label": "Soft tissue",        "note": "Spongy — muscle or soft tissue limiting" },
      { "value": "bony",          "label": "Bony",               "note": "Hard stop — bony block" },
      { "value": "empty",         "label": "Empty (pain-limited)","note": "Patient stops before end range due to pain — serious" },
      { "value": "springy",       "label": "Springy",            "note": "Rebound feel — possible loose body or meniscus" }
    ],
    "accessory_movement_stiffness": ["Normal", "Slightly stiff", "Stiff", "Very stiff"],
    "accessory_movement_pain":      ["None",   "Familiar pain",  "Different pain", "Severe pain"]
  },

