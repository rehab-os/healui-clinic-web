{
  "prom_id": "FIM",
  "full_name": "Functional Independence Measure",
  "version": "1.0",
  "copyright": "© Uniform Data System for Medical Rehabilitation, 1987",
  "language": "English",
  "total_items": 18,
  "estimated_time_minutes": 20,
  "description": "An 18-item clinician-rated instrument designed to assess the level of disability and burden of care for individuals with various medical conditions. It measures both motor and cognitive function across self-care, sphincter control, transfers, locomotion, communication, and social cognition domains. Widely used in rehabilitation settings.",
  "instructions": "Rate each item based on the level of assistance required by the patient to perform the activity safely. Consider performance during the past 24-48 hours.",
  "scoring": {
    "method": "subscale_sum",
    "total_score": {
      "min": 18,
      "max": 126,
      "calculation": "Sum of all 18 items (each scored 1-7). Motor: 91 points max, Cognitive: 35 points max",
      "interpretation": {
        "18-36": "Total assistance required",
        "37-54": "Maximal assistance required",
        "55-72": "Moderate assistance required",
        "73-90": "Minimal assistance to supervision required",
        "91-108": "Modified independence (using devices)",
        "109-126": "Complete independence"
      },
      "higher_is_better": true,
      "mcid": 22,
      "note": "7-level scale: 7=Complete Independence, 6=Modified Independence, 5=Supervision, 4=Minimal Assist, 3=Moderate Assist, 2=Maximal Assist, 1=Total Assist"
    },
    "subscales": [
      {
        "id": "motor",
        "name": "Motor",
        "items": 13,
        "min": 13,
        "max": 91
      },
      {
        "id": "cognitive",
        "name": "Cognitive",
        "items": 5,
        "min": 5,
        "max": 35
      }
    ]
  },
