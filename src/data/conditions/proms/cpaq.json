{
  "prom_id": "CPAQ",
  "full_name": "Chronic Pain Acceptance Questionnaire",
  "version": "CPAQ-20",
  "copyright": "© McCracken et al., 2004",
  "language": "English",
  "total_items": 20,
  "estimated_time_minutes": 5,
  "description": "A 20-item self-report measure that assesses acceptance of chronic pain. It consists of two subscales: Activity Engagement (pursuing life activities regardless of pain) and Pain Willingness (recognition that avoidance and control are ineffective). Higher acceptance is associated with better functioning in chronic pain patients.",
  "instructions": "Below you will find a list of statements. Please rate the truth of each statement as it applies to you. Use the following rating scale to make your choices.",
  "scoring": {
    "method": "subscale_sum",
    "total_score": {
      "min": 0,
      "max": 120,
      "calculation": "Sum of all 20 items (each 0-6). Higher scores = greater pain acceptance.",
      "interpretation": {
        "0-40": "Low acceptance",
        "41-80": "Moderate acceptance",
        "81-120": "High acceptance"
      },
      "higher_is_better": true,
      "mcid": 10,
      "note": "Higher scores indicate greater acceptance and better adjustment to chronic pain"
    },
    "subscales": [
      {
        "id": "activity_engagement",
        "name": "Activity Engagement",
        "items": 11,
        "description": "Pursuing life activities regardless of pain",
        "min": 0,
        "max": 66
      },
      {
        "id": "pain_willingness",
        "name": "Pain Willingness",
        "items": 9,
        "description": "Recognition that avoidance and control of pain are ineffective",
        "min": 0,
        "max": 54
      }
    ]
  },
