  "description": "A brief, multidimensional self-report instrument for assessing female sexual function in the past 4 weeks.",
  "instructions": "These questions ask about your sexual feelings and responses during the past 4 weeks. Please answer the following questions as honestly and clearly as possible. Your responses will be kept completely confidential. In answering these questions, the following definitions apply: Sexual activity can include caressing, foreplay, masturbation, and vaginal intercourse. Sexual intercourse is defined as penile penetration (entry) of the vagina. Sexual stimulation includes situations like foreplay with a partner, self-stimulation (masturbation), or sexual fantasy.",
  "scoring": {
    "method": "domain_weighted_sum",
    "domains": [
      {
        "id": "desire",
        "name": "Desire",
        "items": 2,
        "factor": 0.6,
        "calculation": "Questions 1-2, multiply by 0.6"
      },
      {
        "id": "arousal",
        "name": "Arousal",
        "items": 4,
        "factor": 0.3,
        "calculation": "Questions 3-6, multiply by 0.3"
      },
      {
        "id": "lubrication",
        "name": "Lubrication",
        "items": 4,
        "factor": 0.3,
        "calculation": "Questions 7-10, multiply by 0.3"
      },
      {
        "id": "orgasm",
        "name": "Orgasm",
        "items": 3,
        "factor": 0.4,
        "calculation": "Questions 11-13, multiply by 0.4"
      },
      {
        "id": "satisfaction",
        "name": "Satisfaction",
        "items": 3,
        "factor": 0.4,
        "calculation": "Questions 14-16, multiply by 0.4"
      },
      {
        "id": "pain",
        "name": "Pain",
        "items": 3,
        "factor": 0.4,
        "calculation": "Questions 17-19, multiply by 0.4"
      }
    ],
    "total_score": {
      "min": 2,
      "max": 36,
      "calculation": "Sum of all domain scores (each domain score = sum of items × factor)",
      "interpretation": {
        "2-26.5": "High risk of sexual dysfunction",
        "26.6-36": "Low risk of sexual dysfunction"
      },
      "higher_is_better": true,
      "cutoff": 26.55
    }
  },
