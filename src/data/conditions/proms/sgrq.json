{
  "prom_id": "SGRQ",
  "full_name": "St. George's Respiratory Questionnaire",
  "version": "2.2",
  "copyright": "© Paul Jones, St. George's Hospital Medical School, 1991",
  "language": "English",
  "total_items": 50,
  "estimated_time_minutes": 10,
  "description": "A disease-specific instrument designed to measure impact on overall health, daily life, and perceived well-being in patients with obstructive airways disease.",
  "instructions": "This questionnaire is designed to help us learn more about how your breathing is troubling you and affecting your life. Please read the instructions carefully and ask if you do not understand anything.",
  "scoring": {
    "method": "weighted_component_scores",
    "components": [
      {
        "id": "symptoms",
        "name": "Symptoms",
        "items": 8,
        "calculation": "Weighted score based on symptom frequency and severity"
      },
      {
        "id": "activity",
        "name": "Activity",
        "items": 16,
        "calculation": "Activities that cause or are limited by breathlessness"
      },
      {
        "id": "impacts",
        "name": "Impacts",
        "items": 26,
        "calculation": "Social and psychological impacts of respiratory disease"
      }
    ],
    "total_score": {
      "min": 0,
      "max": 100,
      "calculation": "Weighted sum of all components divided by maximum possible weight × 100",
      "interpretation": {
        "0-25": "Little impact on quality of life",
        "26-50": "Moderate impact on quality of life",
        "51-75": "Significant impact on quality of life",
        "76-100": "Severe impact on quality of life"
      },
      "higher_is_worse": true,
      "mcid": 4
    }
  },
  "sections": [
    {
      "id": "sgrq_part1",
