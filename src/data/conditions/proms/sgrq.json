            { "value": "1", "label": "1 or 2 attacks", "score": 1 },
            { "value": "2", "label": "3 or 4 attacks", "score": 2 },
            { "value": "3", "label": "More than 4 attacks", "score": 3 },
            { "value": "4", "label": "My chest is bad most of the time", "score": 4 }
          ]
        },
        {
          "id": "sgrq_6",
          "question": "How long did the worst attack of chest trouble last? (Go to Q7 if you had no severe attacks)",
          "ui_component": "single_choice",
          "required": false,
          "order": 6,
          "options": [
            { "value": "0", "label": "Less than a day (or no severe attacks)", "score": 0 },
            { "value": "1", "label": "1 or 2 days", "score": 1 },
            { "value": "2", "label": "3 to 7 days", "score": 2 },
            { "value": "3", "label": "More than a week", "score": 3 }
          ]
        },
        {
          "id": "sgrq_7",
