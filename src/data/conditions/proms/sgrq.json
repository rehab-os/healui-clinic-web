          "required": true,
          "order": 7,
          "options": [
            { "value": "0", "label": "No good days", "score": 0 },
            { "value": "1", "label": "1 or 2 good days", "score": 1 },
            { "value": "2", "label": "3 or 4 good days", "score": 2 },
            { "value": "3", "label": "Nearly every day is good", "score": 3 },
            { "value": "4", "label": "Every day is good", "score": 4 }
          ]
        },
        {
