            { "value": "1", "label": "Only with chest infections", "score": 1 },
            { "value": "2", "label": "A few days a month", "score": 2 },
            { "value": "3", "label": "Several days a week", "score": 3 },
            { "value": "4", "label": "Most days a week", "score": 4 },
            { "value": "5", "label": "Every day", "score": 5 }
          ]
        },
        {
