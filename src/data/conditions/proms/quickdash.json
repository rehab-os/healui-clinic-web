{
  "prom_id": "QuickDASH",
  "full_name": "Quick Disabilities of the Arm, Shoulder and Hand",
  "version": "1.0",
  "copyright": "© Institute for Work & Health, 2005",
  "language": "English",
  "total_items": 11,
  "estimated_time_minutes": 5,
  "description": "A shortened version of the DASH outcome measure. It measures physical function and symptoms in people with any musculoskeletal disorder of the upper limb.",
  "instructions": "Please rate your ability to do the following activities in the LAST WEEK by circling the number below the appropriate response.",
  "scoring": {
    "method": "sum_to_score",
    "total_score": {
      "min": 0,
      "max": 100,
      "calculation": "[(sum of n responses / n) - 1] × 25, where n is the number of completed responses",
      "interpretation": {
        "0-25": "Minimal disability",
        "26-50": "Mild to moderate disability",
        "51-75": "Moderate to severe disability",
        "76-100": "Severe disability"
      },
      "higher_is_worse": true,
      "mcid": 14
    }
  },
  "sections": [
    {
      "id": "quickdash_function",
      "title": "Physical Function",
      "description": "Rate your difficulty with these activities in the last week",
      "questions": [
        {
          "id": "quickdash_1",
          "question": "Open a tight or new jar",
          "ui_component": "single_choice",
          "required": true,
          "order": 1,
          "options": [
            { "value": "1", "label": "No difficulty", "score": 1 },
            { "value": "2", "label": "Mild difficulty", "score": 2 },
            { "value": "3", "label": "Moderate difficulty", "score": 3 },
            { "value": "4", "label": "Severe difficulty", "score": 4 },
            { "value": "5", "label": "Unable", "score": 5 }
          ]
        },
        {
