{
  "prom_id": "LYSHOLM",
  "full_name": "Lysholm Knee Scoring Scale",
  "version": "1.0",
  "copyright": "© Lysholm & Gillquist, 1982",
  "language": "English",
  "total_items": 8,
  "estimated_time_minutes": 3,
  "description": "A patient-reported instrument for evaluating outcome after knee ligament surgery. It focuses on knee instability and function during activities of daily living and sports. Widely used for ACL injuries and reconstruction outcomes.",
  "instructions": "Please answer the following questions about your knee by selecting the statement that best describes your current condition.",
  "scoring": {
    "method": "weighted_sum",
    "total_score": {
      "min": 0,
      "max": 100,
      "calculation": "Sum of weighted items (different point values per question)",
      "interpretation": {
        "0-64": "Poor",
        "65-83": "Fair",
        "84-94": "Good",
        "95-100": "Excellent"
      },
      "higher_is_better": true,
      "mcid": 10
    }
  },
  "sections": [
    {
      "id": "lysholm_assessment",
      "title": "Knee Function Assessment",
      "description": "Please select the option that best describes your knee.",
      "questions": [
        {
          "id": "lysholm_1",
          "question": "Limp",
          "ui_component": "single_choice",
          "required": true,
          "order": 1,
          "options": [
            { "value": "5", "label": "None", "score": 5 },
            { "value": "3", "label": "Slight or periodical", "score": 3 },
            { "value": "0", "label": "Severe and constant", "score": 0 }
          ]
        },
        {
          "id": "lysholm_2",
          "question": "Support",
          "ui_component": "single_choice",
          "required": true,
          "order": 2,
          "options": [
            { "value": "5", "label": "None", "score": 5 },
            { "value": "3", "label": "Stick or crutch", "score": 3 },
            { "value": "0", "label": "Weight bearing impossible", "score": 0 }
          ]
        },
        {
          "id": "lysholm_3",
          "question": "Locking",
          "ui_component": "single_choice",
          "required": true,
          "order": 3,
          "options": [
            { "value": "15", "label": "No locking and no catching sensations", "score": 15 },
            { "value": "10", "label": "Catching sensation but no locking", "score": 10 },
            { "value": "6", "label": "Locking occasionally", "score": 6 },
            { "value": "2", "label": "Locking frequently", "score": 2 },
            { "value": "0", "label": "Locked joint on examination", "score": 0 }
          ]
        },
        {
          "id": "lysholm_4",
          "question": "Instability (giving way)",
          "ui_component": "single_choice",
          "required": true,
          "order": 4,
          "options": [
            { "value": "25", "label": "Never", "score": 25 },
            { "value": "20", "label": "Rarely during athletics or other severe exertion", "score": 20 },
            { "value": "15", "label": "Frequently during athletics or other severe exertion (or incapable of participation)", "score": 15 },
            { "value": "10", "label": "Occasionally in daily activities", "score": 10 },
            { "value": "5", "label": "Often in daily activities", "score": 5 },
            { "value": "0", "label": "Every step", "score": 0 }
          ]
        },
        {
          "id": "lysholm_5",
          "question": "Pain",
          "ui_component": "single_choice",
          "required": true,
          "order": 5,
          "options": [
            { "value": "25", "label": "None", "score": 25 },
            { "value": "20", "label": "Inconstant and slight during severe exertion", "score": 20 },
            { "value": "15", "label": "Marked during severe exertion", "score": 15 },
            { "value": "10", "label": "Marked on or after walking more than 2 km", "score": 10 },
            { "value": "5", "label": "Marked on or after walking less than 2 km", "score": 5 },
            { "value": "0", "label": "Constant", "score": 0 }
          ]
        },
        {
          "id": "lysholm_6",
          "question": "Swelling",
          "ui_component": "single_choice",
          "required": true,
          "order": 6,
          "options": [
            { "value": "10", "label": "None", "score": 10 },
            { "value": "6", "label": "With severe exertion", "score": 6 },
            { "value": "2", "label": "With ordinary exertion", "score": 2 },
            { "value": "0", "label": "Constant", "score": 0 }
          ]
        },
        {
          "id": "lysholm_7",
          "question": "Stair climbing",
          "ui_component": "single_choice",
          "required": true,
          "order": 7,
          "options": [
            { "value": "10", "label": "No problems", "score": 10 },
            { "value": "6", "label": "Slightly impaired", "score": 6 },
            { "value": "2", "label": "One step at a time", "score": 2 },
            { "value": "0", "label": "Impossible", "score": 0 }
          ]
        },
        {
          "id": "lysholm_8",
          "question": "Squatting",
          "ui_component": "single_choice",
          "required": true,
          "order": 8,
          "options": [
            { "value": "5", "label": "No problems", "score": 5 },
            { "value": "4", "label": "Slightly impaired", "score": 4 },
            { "value": "2", "label": "Not beyond 90 degrees", "score": 2 },
            { "value": "0", "label": "Impossible", "score": 0 }
          ]
        }
      ]
    }
  ]
}
