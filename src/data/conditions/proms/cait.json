      "interpretation": {
        "0-11": "Severe ankle instability",
        "12-19": "Moderate ankle instability",
        "20-24": "Mild ankle instability",
        "25-27": "Minimal ankle instability",
        "28-30": "Normal ankle stability"
      },
      "higher_is_better": true,
      "mcid": 3,
      "cutoff_score": 27,
      "cutoff_interpretation": "Score ≤27 indicates chronic ankle instability"
    }
  },
