  "description": "A widely used, proprietary set of standardized questionnaires used to evaluate the condition of patients with osteoarthritis of the knee and hip, including pain, stiffness, and physical functioning of the joints.",
  "instructions": "Please rate the following activities in the last 48 hours.",
  "scoring": {
    "method": "subscale_sum",
    "total_score": {
      "min": 0,
      "max": 96,
      "calculation": "Sum of all items (Pain: 0-20, Stiffness: 0-8, Function: 0-68). Can be normalized to 0-100 scale.",
      "interpretation": {
        "0-24": "Mild osteoarthritis symptoms",
        "25-48": "Moderate osteoarthritis symptoms",
        "49-96": "Severe osteoarthritis symptoms"
      },
      "higher_is_better": false,
      "mcid": 9.7
    },
