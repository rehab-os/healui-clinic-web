{
  "prom_id": "HOOS",
  "full_name": "Hip Disability and Osteoarthritis Outcome Score",
  "version": "2.0",
  "copyright": "© Ewa Roos, 2012",
  "language": "English",
  "total_items": 40,
  "estimated_time_minutes": 10,
  "description": "A patient-reported outcome measure for hip disability and osteoarthritis. The HOOS evaluates both short-term and long-term symptoms and function in subjects with hip injury and osteoarthritis.",
  "instructions": "This survey asks for your view about your hip. This information will help us keep track of how you feel about your hip and how well you are able to do your usual activities. Answer every question by ticking the appropriate box, only one box for each question.",
  "scoring": {
    "method": "subscale_percentage",
    "subscales": [
      {
        "id": "symptoms",
        "name": "Symptoms",
        "items": 5,
        "calculation": "100 - (sum of items × 100 / (4 × number of items))"
      },
      {
        "id": "pain",
        "name": "Pain",
        "items": 10,
        "calculation": "100 - (sum of items × 100 / (4 × number of items))"
      },
      {
        "id": "adl",
        "name": "Activities of Daily Living (ADL)",
        "items": 17,
        "calculation": "100 - (sum of items × 100 / (4 × number of items))"
      },
      {
        "id": "sport",
        "name": "Sport and Recreation",
        "items": 4,
        "calculation": "100 - (sum of items × 100 / (4 × number of items))"
      },
      {
        "id": "qol",
        "name": "Quality of Life (QOL)",
        "items": 4,
        "calculation": "100 - (sum of items × 100 / (4 × number of items))"
      }
    ],
    "total_score": {
      "min": 0,
      "max": 100,
      "interpretation": {
        "0-39": "Severe hip problems",
        "40-59": "Moderate hip problems",
        "60-79": "Mild hip problems",
        "80-100": "No hip problems"
      },
      "higher_is_better": true
    }
  },
