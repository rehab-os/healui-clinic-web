  "description": "A 13-item self-report questionnaire designed to measure catastrophic thinking related to pain. It assesses three dimensions: rumination, magnification, and helplessness.",
  "instructions": "We are interested in the types of thoughts and feelings that you have when you are in pain. Listed below are thirteen statements describing different thoughts and feelings that may be associated with pain. Using the following scale, please indicate the degree to which you have these thoughts and feelings when you are experiencing pain.",
  "scoring": {
    "method": "subscale_sum",
    "total_score": {
      "min": 0,
      "max": 52,
      "calculation": "Sum of all items (range 0-52). Higher scores indicate greater pain catastrophizing.",
      "interpretation": {
        "0-19": "Low catastrophizing",
        "20-29": "Moderate catastrophizing",
        "30-52": "High catastrophizing"
      },
      "higher_is_better": false,
      "mcid": 9.6,
      "clinical_cutoff": 30
    },
