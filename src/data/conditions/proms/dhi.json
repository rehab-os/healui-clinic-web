  "language": "English",
  "total_items": 25,
  "estimated_time_minutes": 7,
  "description": "A 25-item self-assessment questionnaire designed to evaluate the self-perceived handicapping effects imposed by dizziness. It assesses functional, emotional, and physical aspects of dizziness and unsteadiness.",
  "instructions": "The purpose of this questionnaire is to identify difficulties that you may be experiencing because of your dizziness. Please answer 'Yes', 'No', or 'Sometimes' to each question. Answer each question as it pertains to your dizziness problem only.",
  "scoring": {
    "method": "subscale_sum",
    "total_score": {
      "min": 0,
      "max": 100,
      "calculation": "Yes = 4 points, Sometimes = 2 points, No = 0 points. Sum all items (max 100).",
      "interpretation": {
        "0-14": "No perceived handicap",
        "16-34": "Mild handicap",
        "36-52": "Moderate handicap",
        "54-100": "Severe handicap"
      },
      "higher_is_better": false,
      "mcid": 18
    },
    "subscales": [
      {
        "id": "physical",
        "name": "Physical",
        "items": [1, 4, 8, 11, 13, 17, 25],
        "max": 28
      },
      {
        "id": "emotional",
        "name": "Emotional",
        "items": [2, 9, 10, 15, 18, 20, 21, 22, 23],
        "max": 36
      },
      {
        "id": "functional",
        "name": "Functional",
        "items": [3, 5, 6, 7, 12, 14, 16, 19, 24],
        "max": 36
      }
    ]
  },
