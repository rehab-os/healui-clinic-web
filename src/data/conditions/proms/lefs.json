{
  "prom_id": "LEFS",
  "full_name": "Lower Extremity Functional Scale",
  "version": "1.0",
  "copyright": "Public domain (Binkley et al., 1999)",
  "language": "English",
  "total_items": 20,
  "estimated_time_minutes": 5,
  "description": "A questionnaire to measure patients' initial function, ongoing progress, and outcome for a wide range of lower extremity conditions.",
  "instructions": "We are interested in knowing whether you are having any difficulty at all with the activities listed below because of your lower limb problem. Please provide an answer for EACH activity. Today, do you or would you have any difficulty at all with:",
  "scoring": {
    "method": "sum_total",
    "total_score": {
      "min": 0,
      "max": 80,
      "calculation": "Sum of all 20 items (each scored 0-4)",
      "interpretation": {
        "0-40": "Severe functional limitation",
        "41-60": "Moderate functional limitation",
        "61-75": "Mild functional limitation",
        "76-80": "Normal function"
      },
      "higher_is_better": true,
      "mcid": 9
    }
  },
