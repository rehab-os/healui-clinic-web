  "estimated_time_minutes": 5,
  "description": "A 12-item patient-reported questionnaire specifically designed and developed for assessing outcomes of shoulder surgery. It contains questions on pain and shoulder function, particularly activities of daily living. Widely used in the UK and internationally.",
  "instructions": "Please answer the questions about your shoulder problem. Consider how your shoulder has been during the past 4 weeks.",
  "scoring": {
    "method": "sum_total",
    "total_score": {
      "min": 0,
      "max": 48,
      "calculation": "Sum of all 12 items (each scored 0-4). Original scoring was 12-60 with lower=better; modern scoring uses 0-48 with higher=better.",
      "interpretation": {
        "0-19": "Severe shoulder problems",
        "20-29": "Moderate to severe shoulder problems",
        "30-39": "Mild to moderate shoulder problems",
        "40-48": "Satisfactory shoulder function"
      },
      "higher_is_better": true,
      "mcid": 5
    }
  },
