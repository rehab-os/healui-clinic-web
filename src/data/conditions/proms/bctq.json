  "total_items": 19,
  "estimated_time_minutes": 5,
  "description": "A disease-specific questionnaire for carpal tunnel syndrome consisting of two distinct scales: a Symptom Severity Scale (11 items) and a Functional Status Scale (8 items). It is widely used to assess severity and treatment outcomes.",
  "instructions": "The following questions refer to your symptoms for a typical 24-hour period during the past two weeks. Please circle one answer to each question.",
  "scoring": {
    "method": "subscale_average",
    "total_score": {
      "min": 1.0,
      "max": 5.0,
      "calculation": "Average of both subscale scores. Each subscale scored separately then averaged.",
      "interpretation": {
        "1.0-1.9": "Mild symptoms",
        "2.0-2.9": "Moderate symptoms",
        "3.0-5.0": "Severe symptoms"
      },
      "higher_is_better": false,
      "mcid": 0.85
    },
    "subscales": [
      {
        "id": "symptom_severity",
        "name": "Symptom Severity Scale (SSS)",
        "items": 11,
        "min": 1.0,
        "max": 5.0,
        "calculation": "Sum of 11 items / 11",
        "mcid": 1.04
      },
      {
        "id": "functional_status",
        "name": "Functional Status Scale (FSS)",
        "items": 8,
        "min": 1.0,
        "max": 5.0,
        "calculation": "Sum of 8 items / 8",
        "mcid": 0.74
      }
    ]
  },
