  "copyright": "© Ohrbach et al., 2008",
  "language": "English",
  "total_items": 20,
  "estimated_time_minutes": 5,
  "description": "A 20-item self-report measure designed to assess functional limitations of the jaw in patients with temporomandibular disorders (TMD). It consists of three subscales: Mastication, Jaw Mobility, and Verbal/Emotional Communication. Higher scores indicate greater limitation.",
  "instructions": "In the past month, how much have the following activities been limited by problems with your jaw?",
  "scoring": {
    "method": "subscale_average",
    "total_score": {
      "min": 0,
      "max": 10,
      "calculation": "Mean of all items (each 0-10). Can also calculate subscale scores separately.",
      "interpretation": {
        "0-2": "No to minimal limitation",
        "2.1-4": "Mild limitation",
        "4.1-6": "Moderate limitation",
        "6.1-10": "Severe limitation"
      },
      "higher_is_better": false,
      "mcid": 1.5
    },
    "subscales": [
      {
        "id": "mastication",
        "name": "Mastication",
        "items": 8,
        "min": 0,
        "max": 10,
        "questions": [1, 2, 3, 4, 5, 6, 7, 8]
      },
      {
        "id": "mobility",
