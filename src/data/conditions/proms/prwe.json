{
  "prom_id": "PRWE",
  "full_name": "Patient-Rated Wrist Evaluation",
  "version": "1.0",
  "copyright": "© MacDermid, 1998",
  "language": "English",
  "total_items": 15,
  "estimated_time_minutes": 5,
  "description": "A 15-item questionnaire designed to measure wrist pain and disability in activities of daily living. It is a reliable, valid, and responsive outcome measure for distal radius fractures and other wrist conditions.",
  "instructions": "Rate the average amount of pain and difficulty you have had during the past week.",
  "scoring": {
    "method": "subscale_sum_to_total",
    "total_score": {
      "min": 0,
      "max": 100,
      "calculation": "Pain subscore (max 50) + Function subscore (max 50). Best score = 100/100 converted to 0/100 for clinical reporting.",
      "interpretation": {
        "0-24": "Mild wrist disability",
        "25-49": "Moderate wrist disability",
        "50-100": "Severe wrist disability"
      },
      "higher_is_better": false,
      "mcid": 11.5
    },
    "subscales": [
      {
        "id": "pain",
        "name": "Pain",
        "items": 5,
        "min": 0,
        "max": 50,
        "calculation": "Sum of 5 pain items (each 0-10)"
      },
      {
        "id": "function",
        "name": "Function",
        "items": 10,
        "min": 0,
        "max": 50,
        "calculation": "Sum of 10 function items / 2 (average of specific and usual activities)"
      }
    ]
  },
  "sections": [
