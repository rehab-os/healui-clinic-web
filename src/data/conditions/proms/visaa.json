  "description": "A self-administered questionnaire designed to assess severity of Achilles tendinopathy. The VISA-A is both a measure of severity and ability to undertake sports.",
  "instructions": "Please answer every question. Only circle ONE response for each question.",
  "scoring": {
    "method": "sum_total",
    "total_score": {
      "min": 0,
      "max": 100,
      "calculation": "Sum of all items (max 100 points)",
      "interpretation": {
        "0-39": "Severe Achilles tendinopathy",
        "40-69": "Moderate Achilles tendinopathy",
        "70-89": "Mild Achilles tendinopathy",
        "90-100": "Asymptomatic or near-normal function"
      },
      "higher_is_better": true,
      "mcid": 6.5
    }
  },
  "sections": [
