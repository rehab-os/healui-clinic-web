  "language": "English",
  "total_items": 30,
  "estimated_time_minutes": 10,
  "description": "A region-specific outcome measure designed to measure physical function and symptoms in people with any musculoskeletal disorder of the upper limb.",
  "instructions": "Please rate your ability to do the following activities in the LAST WEEK by circling the number below the appropriate response.",
  "scoring": {
    "method": "sum_to_score",
    "total_score": {
      "min": 0,
      "max": 100,
      "calculation": "[(sum of n responses / n) - 1] × 25, where n is the number of completed responses (minimum 27 of 30)",
      "interpretation": {
        "0-25": "Minimal disability",
        "26-50": "Mild to moderate disability",
        "51-75": "Moderate to severe disability",
        "76-100": "Severe disability"
      },
      "higher_is_worse": true,
      "mcid": 10
    }
  },
