  "description": "A 17-item questionnaire designed to measure fear of movement or (re)injury. Originally developed for patients with chronic musculoskeletal pain, it assesses fear-avoidance beliefs and is widely used in physiotherapy and rehabilitation settings.",
  "instructions": "Please rate how much you agree or disagree with each of the following statements.",
  "scoring": {
    "method": "sum_total",
    "total_score": {
      "min": 17,
      "max": 68,
      "calculation": "Sum of all items (items 4, 8, 12, 16 are reverse scored). Higher scores indicate greater fear of movement.",
      "interpretation": {
        "17-36": "Low kinesiophobia",
        "37-42": "Moderate kinesiophobia",
        "43-68": "High kinesiophobia (clinically significant fear-avoidance)"
      },
      "higher_is_better": false,
      "mcid": 5.5,
      "clinical_cutoff": 37
    }
  },
