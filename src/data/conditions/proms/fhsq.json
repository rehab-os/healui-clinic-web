{
  "prom_id": "FHSQ",
  "full_name": "Foot Health Status Questionnaire",
  "version": "1.0",
  "copyright": "(c) Bennett et al., 1998",
  "language": "English",
  "total_items": 13,
  "estimated_time_minutes": 5,
  "description": "A self-administered questionnaire to assess foot health-related quality of life across four domains: foot pain, foot function, footwear, and general foot health.",
  "instructions": "Please answer each question based on your experience during the PAST WEEK. Select the response that best describes your foot health.",
  "scoring": {
    "method": "subscale_average_to_percentage",
    "subscales": [
      {
        "id": "foot_pain",
        "name": "Foot Pain",
        "items": 4,
        "calculation": "Reverse-score items (5 - raw + 1), then ((sum - 4) / 16) × 100"
      },
      {
        "id": "foot_function",
        "name": "Foot Function",
        "items": 4,
        "calculation": "Reverse-score items (5 - raw + 1), then ((sum - 4) / 16) × 100"
      },
      {
        "id": "footwear",
        "name": "Footwear",
        "items": 3,
        "calculation": "((sum - 3) / 12) × 100 (no reversal needed)"
      },
      {
        "id": "general_foot_health",
        "name": "General Foot Health",
        "items": 2,
        "calculation": "Reverse-score items (5 - raw + 1), then ((sum - 2) / 8) × 100"
      }
    ],
    "total_score": {
      "min": 0,
      "max": 100,
      "calculation": "Average of four domain percentages (Foot Pain, Foot Function, Footwear, General Foot Health)",
      "interpretation": {
        "0-25": "Poor foot health",
        "26-50": "Fair foot health",
        "51-75": "Good foot health",
        "76-100": "Excellent foot health"
      },
      "higher_is_worse": false,
      "mcid": 12
    }
  },
