      "interpretation": {
        "0-49": "Poor shoulder function",
        "50-69": "Fair shoulder function",
        "70-84": "Good shoulder function",
        "85-100": "Excellent shoulder function"
      },
      "higher_is_better": true,
      "mcid": 6.4
    }
