  "language": "English",
  "total_items": 41,
  "estimated_time_minutes": 10,
  "description": "A disease-specific quality of life questionnaire for patients with vertebral osteoporosis, focusing on pain, physical function, social function, general health, and mental function.",
  "instructions": "Please answer all questions by ticking the response that best describes your situation DURING THE LAST WEEK.",
  "scoring": {
    "method": "domain_average_to_percentage",
    "domains": [
      {
        "id": "pain",
        "name": "Pain",
        "items": 5,
        "calculation": "Sum divided by (5 × 4) × 100"
      },
      {
        "id": "physical_function",
        "name": "Physical Function",
        "items": 17,
        "calculation": "Sum divided by (17 × 4) × 100"
      },
      {
        "id": "social_function",
        "name": "Social Function",
        "items": 7,
        "calculation": "Sum divided by (7 × 4) × 100"
      },
      {
        "id": "general_health",
        "name": "General Health Perception",
        "items": 3,
        "calculation": "Sum divided by (3 × 4) × 100"
      },
      {
        "id": "mental_function",
        "name": "Mental Function",
        "items": 9,
        "calculation": "Sum divided by (9 × 4) × 100"
      }
    ],
    "total_score": {
      "min": 0,
      "max": 100,
      "calculation": "Average of all 5 domain scores",
      "interpretation": {
        "0-25": "Good quality of life",
        "26-50": "Moderate quality of life",
        "51-75": "Poor quality of life",
        "76-100": "Very poor quality of life"
      },
      "higher_is_worse": true
    }
  },
