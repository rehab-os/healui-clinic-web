{
  "prom_id": "PRTEE",
  "full_name": "Patient-Rated Tennis Elbow Evaluation",
  "version": "1.0",
  "copyright": "© Overend et al., 2003",
  "language": "English",
  "total_items": 15,
  "estimated_time_minutes": 5,
  "description": "A 15-item questionnaire designed to measure forearm pain and disability in patients with lateral epicondylitis (tennis elbow).",
  "instructions": "Please rate your average pain and difficulty with the following activities over the PAST WEEK.",
  "scoring": {
    "method": "subscale_sum_to_total",
    "subscales": [
      {
        "id": "pain",
        "name": "Pain",
        "items": 5,
        "max_score": 50,
        "calculation": "Sum of 5 pain items (each 0-10)"
      },
      {
        "id": "function",
        "name": "Function",
        "items": 10,
        "max_score": 100,
        "calculation": "Sum of 10 function items (each 0-10)"
      }
    ],
    "total_score": {
      "min": 0,
      "max": 100,
      "calculation": "(Pain subscore/2 + Function subscore/2)",
      "interpretation": {
        "0-25": "Mild symptoms",
        "26-50": "Moderate symptoms",
        "51-75": "Severe symptoms",
        "76-100": "Extreme symptoms"
      },
      "higher_is_worse": true,
      "mcid": 11
    }
  },
  "sections": [
