{
  "prom_id": "SRS-22",
  "full_name": "Scoliosis Research Society-22 Patient Questionnaire",
  "version": "1.0",
  "copyright": "© Scoliosis Research Society, 2003",
  "language": "English",
  "total_items": 22,
  "estimated_time_minutes": 7,
  "description": "A disease-specific health-related quality of life questionnaire for patients with adolescent idiopathic scoliosis and other spinal deformities.",
  "instructions": "Please indicate your response to each question by marking one box per question that most accurately describes you.",
  "scoring": {
    "method": "subscale_average",
    "subscales": [
      {
        "id": "function",
        "name": "Function/Activity",
        "items": 5,
        "calculation": "Average of 5 items (questions 5, 9, 12, 15, 18)"
      },
      {
        "id": "pain",
        "name": "Pain",
        "items": 5,
        "calculation": "Average of 5 items (questions 1, 2, 8, 11, 17)"
      },
      {
        "id": "self_image",
        "name": "Self-Image/Appearance",
        "items": 6,
        "calculation": "Average of 6 items (questions 4, 6, 10, 14, 19, 22)"
      },
      {
        "id": "mental_health",
        "name": "Mental Health",
        "items": 5,
        "calculation": "Average of 5 items (questions 3, 7, 13, 16, 20)"
      },
      {
        "id": "satisfaction",
        "name": "Satisfaction with Management",
        "items": 1,
        "calculation": "Single item (question 21) - only for postoperative patients"
      }
    ],
    "total_score": {
      "min": 1,
      "max": 5,
      "calculation": "Average of all domain scores (excluding satisfaction domain for preoperative patients)",
      "interpretation": {
        "1-2": "Poor quality of life",
        "2-3": "Fair quality of life",
        "3-4": "Good quality of life",
        "4-5": "Excellent quality of life"
      },
      "higher_is_better": true,
      "mcid": 0.4
    }
  },
