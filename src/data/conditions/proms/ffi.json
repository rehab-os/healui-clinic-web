{
  "prom_id": "FFI",
  "full_name": "Foot Function Index",
  "version": "1.0",
  "copyright": "Public domain (Budiman-Mak, Conrad, Roach, 1991)",
  "language": "English",
  "total_items": 23,
  "estimated_time_minutes": 7,
  "description": "A self-report measure of foot pain, disability, and activity limitation. Originally developed for rheumatoid arthritis, now validated across foot pathology populations.",
  "instructions": "Please rate each item based on your experience during the PAST WEEK. If an item does not apply to you, select 'Not applicable'.",
  "scoring": {
    "method": "subscale_average_to_percentage",
    "subscales": [
      {
        "id": "pain",
        "name": "Pain",
        "items": 9,
        "calculation": "Sum of applicable pain items divided by maximum possible (applicable items × 10), multiplied by 100"
      },
      {
        "id": "disability",
        "name": "Disability",
        "items": 9,
        "calculation": "Sum of applicable disability items divided by maximum possible (applicable items × 10), multiplied by 100"
      },
      {
        "id": "activity_limitation",
        "name": "Activity Limitation",
        "items": 5,
        "calculation": "Sum of applicable activity limitation items divided by maximum possible (applicable items × 10), multiplied by 100"
      }
    ],
    "total_score": {
      "min": 0,
      "max": 100,
      "calculation": "Average of Pain, Disability, and Activity Limitation subscale percentages",
      "interpretation": {
        "0-9": "Minimal functional limitation",
        "10-30": "Mild impairment",
        "31-60": "Moderate impairment",
        "61-100": "Severe dysfunction"
      },
      "higher_is_worse": true,
      "mcid": 7
    }
  },
