  "language": "English",
  "total_items": 21,
  "estimated_time_minutes": 7,
  "description": "A disease-specific quality of life measurement tool for patients with shoulder instability. The WOSI is designed to evaluate the impact of shoulder instability on physical symptoms, sports/recreation/work, lifestyle, and emotions.",
  "instructions": "Please indicate the amount of difficulty you have experienced in the following situations during the last week by placing a mark on the line.",
  "scoring": {
    "method": "domain_percentage",
    "total_score": {
      "min": 0,
      "max": 2100,
      "calculation": "Sum of all VAS scores (each 0-100mm). Can be expressed as percentage: (Total/2100) × 100",
      "interpretation": {
        "0-525": "Excellent (0-25% disability)",
        "526-1050": "Good (25-50% disability)",
        "1051-1575": "Fair (50-75% disability)",
        "1576-2100": "Poor (75-100% disability)"
      },
      "higher_is_better": false,
      "mcid": 252,
      "note": "Lower scores indicate better function"
    },
    "domains": [
      {
        "id": "physical_symptoms",
        "name": "Physical Symptoms",
        "items": 10,
        "max": 1000
      },
      {
        "id": "sports_recreation_work",
        "name": "Sports/Recreation/Work",
        "items": 4,
        "max": 400
      },
      {
        "id": "lifestyle",
