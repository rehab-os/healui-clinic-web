{
  "prom_id": "SPADI",
  "full_name": "Shoulder Pain and Disability Index",
  "version": "1.0",
  "copyright": "Public domain (Roach et al., 1991)",
  "language": "English",
  "total_items": 13,
  "estimated_time_minutes": 5,
  "description": "A self-administered questionnaire that measures shoulder pain and disability in an outpatient setting.",
  "instructions": "Please place a mark on the line that best represents your experience during the LAST WEEK.",
  "scoring": {
    "method": "subscale_average_to_percentage",
    "subscales": [
      {
        "id": "pain",
        "name": "Pain Subscale",
        "items": 5,
        "calculation": "Sum of 5 pain items divided by 50 (max possible), multiplied by 100"
      },
      {
        "id": "disability",
        "name": "Disability Subscale",
        "items": 8,
        "calculation": "Sum of 8 disability items divided by 80 (max possible), multiplied by 100"
      }
    ],
    "total_score": {
      "min": 0,
      "max": 100,
      "calculation": "Average of Pain and Disability subscale percentages",
      "interpretation": {
        "0-20": "Minimal disability",
        "21-40": "Moderate disability",
        "41-60": "Severe disability",
        "61-100": "Complete disability"
      },
      "higher_is_worse": true
    }
  },
  "sections": [
    {
