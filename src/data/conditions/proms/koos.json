{
  "prom_id": "KOOS",
  "full_name": "Knee Injury and Osteoarthritis Outcome Score",
  "version": "2.0",
  "copyright": "© Ewa Roos, 2012",
  "language": "English",
  "total_items": 42,
  "estimated_time_minutes": 10,
  "description": "A patient-reported outcome measure for knee injury and osteoarthritis. The KOOS evaluates both short-term and long-term symptoms and function in subjects with knee injury and osteoarthritis.",
  "instructions": "This survey asks for your view about your knee. This information will help us keep track of how you feel about your knee and how well you are able to do your usual activities. Answer every question by ticking the appropriate box, only one box for each question.",
  "scoring": {
    "method": "subscale_percentage",
    "subscales": [
      {
        "id": "symptoms",
        "name": "Symptoms",
        "items": 7,
        "calculation": "100 - (sum of items × 100 / (4 × number of items))"
      },
      {
        "id": "pain",
        "name": "Pain",
        "items": 9,
        "calculation": "100 - (sum of items × 100 / (4 × number of items))"
      },
      {
        "id": "adl",
        "name": "Activities of Daily Living (ADL)",
        "items": 17,
        "calculation": "100 - (sum of items × 100 / (4 × number of items))"
      },
      {
        "id": "sport",
        "name": "Sport and Recreation",
        "items": 5,
        "calculation": "100 - (sum of items × 100 / (4 × number of items))"
      },
      {
        "id": "qol",
        "name": "Quality of Life (QOL)",
        "items": 4,
        "calculation": "100 - (sum of items × 100 / (4 × number of items))"
      }
    ],
    "total_score": {
      "min": 0,
      "max": 100,
      "interpretation": {
        "0-39": "Severe knee problems",
        "40-59": "Moderate knee problems",
        "60-79": "Mild knee problems",
        "80-100": "No knee problems"
      },
      "higher_is_better": true
    }
  },
