{
  "prom_id": "IKDC",
  "full_name": "International Knee Documentation Committee Subjective Knee Form",
  "version": "2000",
  "copyright": "© IKDC Committee, 2000",
  "language": "English",
  "total_items": 18,
  "estimated_time_minutes": 5,
  "description": "A knee-specific patient-reported outcome measure designed to detect improvement or deterioration in symptoms, function, and sports activity in patients with a variety of knee conditions.",
  "instructions": "Please answer all questions. For each question, select the response that best describes you. If the activity in question is limited by something other than your knee, mark not applicable (N/A).",
  "scoring": {
    "method": "sum_to_percentage",
    "total_score": {
      "min": 0,
      "max": 100,
      "calculation": "(Sum of items / Maximum possible score) × 100",
      "interpretation": {
        "0-49": "Poor knee function",
        "50-64": "Fair knee function",
        "65-83": "Good knee function",
        "84-100": "Excellent knee function"
      },
      "higher_is_better": true,
      "mcid": 8.8
    }
  },
  "sections": [
    {
      "id": "ikdc_symptoms",
      "title": "Symptoms",
      "description": "Grade symptoms at the highest activity level at which you think you could function without significant symptoms, even if you are not actually performing activities at this level.",
      "questions": [
        {
          "id": "ikdc_1",
          "question": "What is the highest level of activity that you can perform without significant knee pain?",
          "ui_component": "single_choice",
          "required": true,
          "order": 1,
          "options": [
            { "value": "4", "label": "Very strenuous activities like jumping or pivoting as in basketball or soccer", "score": 4 },
            { "value": "3", "label": "Strenuous activities like heavy physical work, skiing or tennis", "score": 3 },
            { "value": "2", "label": "Moderate activities like moderate physical work, running or jogging", "score": 2 },
            { "value": "1", "label": "Light activities like walking, housework or yard work", "score": 1 },
            { "value": "0", "label": "Unable to perform any of the above activities due to knee pain", "score": 0 }
          ]
        },
        {
          "id": "ikdc_2",
          "question": "During the past 4 weeks, or since your injury, how often have you had pain?",
          "ui_component": "single_choice",
          "required": true,
          "order": 2,
          "options": [
            { "value": "0", "label": "Constantly", "score": 0 },
            { "value": "1", "label": "Daily", "score": 1 },
            { "value": "2", "label": "Several times a day", "score": 2 },
            { "value": "3", "label": "Once a day", "score": 3 },
            { "value": "4", "label": "Once or twice", "score": 4 },
            { "value": "5", "label": "Never", "score": 5 }
          ]
        },
        {
          "id": "ikdc_3",
          "question": "If you have pain, how severe is it?",
          "ui_component": "slider",
          "required": true,
          "order": 3,
          "min": 0,
          "max": 10,
          "step": 1,
          "labels": {
            "0": "No pain",
            "10": "Worst pain imaginable"
          }
        },
        {
          "id": "ikdc_4",
          "question": "During the past 4 weeks, or since your injury, how stiff or swollen was your knee?",
          "ui_component": "single_choice",
          "required": true,
          "order": 4,
          "options": [
            { "value": "4", "label": "Not at all", "score": 4 },
            { "value": "3", "label": "Mildly", "score": 3 },
            { "value": "2", "label": "Moderately", "score": 2 },
            { "value": "1", "label": "Very", "score": 1 },
            { "value": "0", "label": "Extremely", "score": 0 }
          ]
        },
        {
          "id": "ikdc_5",
          "question": "What is the highest level of activity you can perform without significant swelling in your knee?",
          "ui_component": "single_choice",
          "required": true,
          "order": 5,
          "options": [
            { "value": "4", "label": "Very strenuous activities like jumping or pivoting as in basketball or soccer", "score": 4 },
            { "value": "3", "label": "Strenuous activities like heavy physical work, skiing or tennis", "score": 3 },
            { "value": "2", "label": "Moderate activities like moderate physical work, running or jogging", "score": 2 },
            { "value": "1", "label": "Light activities like walking, housework or yard work", "score": 1 },
            { "value": "0", "label": "Unable to perform any of the above activities due to knee swelling", "score": 0 }
          ]
        },
        {
          "id": "ikdc_6",
          "question": "During the past 4 weeks, or since your injury, did your knee lock or catch?",
          "ui_component": "yes_no",
          "required": true,
          "order": 6
        },
        {
          "id": "ikdc_7",
          "question": "What is the highest level of activity you can perform without significant giving way in your knee?",
          "ui_component": "single_choice",
          "required": true,
          "order": 7,
          "options": [
            { "value": "4", "label": "Very strenuous activities like jumping or pivoting as in basketball or soccer", "score": 4 },
            { "value": "3", "label": "Strenuous activities like heavy physical work, skiing or tennis", "score": 3 },
            { "value": "2", "label": "Moderate activities like moderate physical work, running or jogging", "score": 2 },
            { "value": "1", "label": "Light activities like walking, housework or yard work", "score": 1 },
            { "value": "0", "label": "Unable to perform any of the above activities due to giving way of the knee", "score": 0 }
          ]
        }
      ]
    },
