{
  "prom_id": "ABC",
  "full_name": "Activities-Specific Balance Confidence Scale",
  "version": "1.0",
  "copyright": "© Powell & Myers, 1995",
  "language": "English",
  "total_items": 16,
  "estimated_time_minutes": 5,
  "description": "A self-report measure of balance confidence in performing various ambulatory activities without losing balance or experiencing a sense of unsteadiness. It is particularly useful for assessing perceived level of confidence in performing specific activities among older adults and individuals with balance disorders.",
  "instructions": "For each of the following activities, please indicate your level of self-confidence by choosing a corresponding number from the following rating scale: 0% = no confidence, 100% = completely confident. If you do not currently do the activity in question, try and imagine how confident you would be if you had to do the activity. If you normally use a walking aid to do the activity or hold onto someone, rate your confidence as if you were using these supports.",
  "scoring": {
    "method": "average_percentage",
    "total_score": {
      "min": 0,
      "max": 100,
      "calculation": "Sum of all items / 16. Score represents percentage of confidence.",
      "interpretation": {
        "0-49": "Low level of physical functioning (high fall risk)",
        "50-79": "Moderate level of physical functioning (moderate fall risk)",
        "80-100": "High level of physical functioning (low fall risk)"
      },
      "higher_is_better": true,
      "mcid": 13,
      "clinical_cutoff": 67,
      "cutoff_interpretation": "Score <67% indicates increased fall risk in community-dwelling older adults"
    }
  },
