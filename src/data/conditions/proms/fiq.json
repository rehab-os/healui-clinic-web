  "copyright": "© Burckhardt et al., 1991",
  "language": "English",
  "total_items": 21,
  "estimated_time_minutes": 7,
  "description": "An assessment and evaluation instrument developed to measure fibromyalgia patient status, progress and outcomes. The FIQ is composed of 10 items measuring physical functioning, work status, depression, anxiety, morning tiredness, pain, stiffness, fatigue, and well-being.",
  "instructions": "For questions 1-10, please mark the point on the line that best indicates how you felt overall for the past week. For question 11, circle the appropriate number.",
  "scoring": {
    "method": "domain_weighted_sum",
    "total_score": {
      "min": 0,
      "max": 100,
      "calculation": "Sum of 10 domain scores (each 0-10, then scaled to 0-100)",
      "interpretation": {
        "0-38": "Mild impact of fibromyalgia",
        "39-58": "Moderate impact of fibromyalgia",
        "59-100": "Severe impact of fibromyalgia"
      },
      "higher_is_better": false,
      "mcid": 14
    }
  },
