{
  "prom_id": "PFDI-20",
  "full_name": "Pelvic Floor Distress Inventory - Short Form 20",
  "version": "1.0",
  "copyright": "© Barber et al., 2005",
  "language": "English",
  "total_items": 20,
  "estimated_time_minutes": 5,
  "description": "A condition-specific quality of life questionnaire that assesses symptom distress and impact on activities in women with pelvic floor disorders.",
  "instructions": "Please answer all of the questions in the following survey. These questions will ask you if you have certain bowel, bladder, or pelvic symptoms and, if you do, how much they bother you. Answer these questions by marking the response that best describes how much each symptom bothers you. Please mark only one number on each line.",
  "scoring": {
    "method": "subscale_sum_to_total",
    "subscales": [
      {
        "id": "popdi",
        "name": "Pelvic Organ Prolapse Distress Inventory (POPDI-6)",
        "items": 6,
        "max_score": 100,
        "calculation": "[(Mean score of answered items - 1) × 25]. Mean calculated as sum/number of items answered. If < 3 items answered, subscale score not calculated."
      },
      {
        "id": "cradi",
        "name": "Colorectal-Anal Distress Inventory (CRADI-8)",
        "items": 8,
        "max_score": 100,
        "calculation": "[(Mean score of answered items - 1) × 25]. Mean calculated as sum/number of items answered. If < 4 items answered, subscale score not calculated."
      },
      {
        "id": "udi",
        "name": "Urinary Distress Inventory (UDI-6)",
        "items": 6,
        "max_score": 100,
        "calculation": "[(Mean score of answered items - 1) × 25]. Mean calculated as sum/number of items answered. If < 3 items answered, subscale score not calculated."
      }
    ],
    "total_score": {
      "min": 0,
      "max": 300,
      "calculation": "Sum of all three subscale scores (POPDI-6 + CRADI-8 + UDI-6)",
      "interpretation": {
        "0-50": "Minimal distress",
        "51-150": "Mild to moderate distress",
        "151-250": "Moderate to severe distress",
        "251-300": "Severe distress"
      },
      "higher_is_worse": true
    }
  },
